<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      WinExe statt Exe: das PVS startet dieses Programm bei jedem Klick auf "Sono".
      Ein aufblitzendes Konsolenfenster wäre dabei jedes Mal sichtbar.
    -->
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>Gdt2Dicom.Connector</RootNamespace>
    <AssemblyName>GDT2DICOM.Aufruf</AssemblyName>
    <ApplicationIcon>..\..\assets\gdt2dicom.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GDT2DICOM.Core\GDT2DICOM.Core.csproj" />
  </ItemGroup>

</Project>
